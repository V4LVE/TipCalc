<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TipCalc.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TipCalc"
    xmlns:views="clr-namespace:TipCalc.Views"
    xmlns:modals="clr-namespace:TipCalc.Views.Modals"
    Title="TipCalc">

    <TabBar >
        <Tab Title="Home" Icon="home.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
        <Tab Title="About" Icon="info.png">
            <ShellContent ContentTemplate="{DataTemplate views:AboutPage}" />
        </Tab>
        <Tab Title="Feedback" Icon="feedback.png">
            <ShellContent ContentTemplate="{DataTemplate modals:FeedbackPage}" />
        </Tab>
    </TabBar>
</Shell>
