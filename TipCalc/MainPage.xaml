<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipCalc.MainPage"
             Title="Home">

    <VerticalStackLayout>

        <Label Text="Bill" />
        <Entry x:Name="BillEntry" Keyboard="Numeric" Placeholder="Enter amount"
               TextChanged="OnBillChanged"/>

        <Label x:Name="TipLabel" Text="Tip: 0 kr."/>
        <Label x:Name="TotalLabel" Text="Total: 0 kr."/>

        <Label Text="Tip Percentage"/>
        <Slider x:Name="TipSlider" 
                Minimum="0" Maximum="100" Value="15"
                ValueChanged="OnTipPercentageChanged"/>
        <Label x:Name="PercentageLabel" Text="15%"/>

        <Button Text="15%" Clicked="On15PercentClicked"/>
        <Button Text="20%" Clicked="On20PercentClicked"/>
        <Button Text="Round Down" Clicked="OnRoundDownClicked"/>
        <Button Text="Round Up" Clicked="OnRoundUpClicked"/>
        <Button Text="Im Feeling Lucky" Clicked="OnFeelingLuckyClicked"/>

    </VerticalStackLayout>
</ContentPage>
