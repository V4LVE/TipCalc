<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipCalc.Views.MonkeyDetailsPage"
             xmlns:models="clr-namespace:TipCalc.Models"
             Title="MonkeyDetailsPage">
    <ScrollView>
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="160, Auto">
                <BoxView
            Grid.ColumnSpan="3"
            Background="{StaticResource Primary}"
            HeightRequest="160"
            HorizontalOptions="FillAndExpand" />
                <Frame
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="0,80,0,0"
            Padding="0"
            CornerRadius="80"
            HeightRequest="160"
            HorizontalOptions="Center"
            IsClippedToBounds="True"
            WidthRequest="160">
                    <Image
                Aspect="AspectFill"
                HeightRequest="160"
                HorizontalOptions="Center"
                Source="{Binding Monkey.Image}"
                VerticalOptions="Center"
                WidthRequest="160" />
                </Frame>
            </Grid>
            <VerticalStackLayout Padding="10" Spacing="10">
                <Label Style="{StaticResource MediumLabel}" Text="{Binding Monkey.Details}" />
                <Label Style="{StaticResource MediumLabel}" Text="{Binding Monkey.Location}" />
                <Label Style="{StaticResource MediumLabel}" Text="{Binding Monkey.Population}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>