<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipCalc.Views.Modals.FeedbackPage"
             BackgroundColor="#F5F6FA"
             Title="Feedback">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Vi vil gerne høre fra dig!"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#2D3436"
                   Margin="0,10,0,0"/>

            <!-- Stjerner -->
            <HorizontalStackLayout x:Name="StarLayout"
                                   HorizontalOptions="Center"
                                   Spacing="10">
                <Image x:Name="Star1" Source="star_outline.png" HeightRequest="40" WidthRequest="40">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Star_Tapped" CommandParameter="1"/>
                    </Image.GestureRecognizers>
                </Image>
                <Image x:Name="Star2" Source="star_outline.png" HeightRequest="40" WidthRequest="40">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Star_Tapped" CommandParameter="2"/>
                    </Image.GestureRecognizers>
                </Image>
                <Image x:Name="Star3" Source="star_outline.png" HeightRequest="40" WidthRequest="40">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Star_Tapped" CommandParameter="3"/>
                    </Image.GestureRecognizers>
                </Image>
                <Image x:Name="Star4" Source="star_outline.png" HeightRequest="40" WidthRequest="40">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Star_Tapped" CommandParameter="4"/>
                    </Image.GestureRecognizers>
                </Image>
                <Image x:Name="Star5" Source="star_outline.png" HeightRequest="40" WidthRequest="40">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Star_Tapped" CommandParameter="5"/>
                    </Image.GestureRecognizers>
                </Image>
            </HorizontalStackLayout>

            <!-- Kort container -->
            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   HasShadow="True"
                   Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label Text="Din feedback"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#2D3436"/>

                    <Editor x:Name="FeedbackEditor"
                            Placeholder="Skriv din feedback her..."
                            AutoSize="TextChanges"
                            FontSize="16"
                            TextColor="#2D3436"
                            BackgroundColor="#F0F2F5"
                            HeightRequest="150"
                            Margin="0,5,0,0"/>

                    <Button Text="Send Feedback"
                            BackgroundColor="#0984E3"
                            TextColor="White"
                            FontSize="18"
                            CornerRadius="25"
                            HeightRequest="50"
                            Clicked="SendFeedback_Clicked"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Luk knap -->
            <Button Text="Luk"
                    BackgroundColor="#dfe6e9"
                    TextColor="#2d3436"
                    FontSize="16"
                    CornerRadius="20"
                    HeightRequest="45"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>