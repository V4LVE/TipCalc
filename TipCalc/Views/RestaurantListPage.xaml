<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipCalc.Views.RestaurantListPage"
             xmlns:model="clr-namespace:TipCalc.Models"
             xmlns:local="clr-namespace:TipCalc.Views"
             Title="RestaurantListPage"
             x:DataType="local:RestaurantListPage">

    <ContentPage.ToolbarItems>
        <ToolbarItem Clicked="AddRes_Clicked" Text="Add" />
        <ToolbarItem Clicked="DeleteRes_Clicked" Text="Delete" />
    </ContentPage.ToolbarItems>

    <CarouselView ItemsSource="{Binding RestaurantList}">
        <CarouselView.ItemTemplate>
            <DataTemplate x:DataType="model:Restaurant">
                <Grid Padding="10">
                    <Border Shadow="True" HeightRequest="125">
                        <Grid Padding="0" ColumnDefinitions="125,*">
                            <Image
                                Aspect="AspectFill"
                                HeightRequest="125"
                                Source="{Binding ImageUrl}"
                                WidthRequest="125" />
                            <VerticalStackLayout Grid.Column="1" Padding="10">
                                <Label Text="{Binding Name}" />
                                <Label Text="{Binding TipPercent, StringFormat='Tip Percent {0:0}%'}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </CarouselView.ItemTemplate>
    </CarouselView>
</ContentPage>